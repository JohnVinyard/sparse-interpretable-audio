%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% File:     waspaa25.sty          (LaTeX Document style option "waspaa25")
%
% Usage:    \documentclass[9pt,conference]{IEEEtran}
%           \usepackage{waspaa25}
%
%           Or for LaTeX 2.09:
% Usage:    \documentstyle[...,conference,waspaa25,...]{IEEEtran}
%
% Purpose:
%
% Style file for WASPAA 2025 Proceeding Manuscripts
%               (2025 IEEE Workshop on Applications of Signal Processing
%                to Audio and Acoustics, Granlibakken Tahoe,
%                Tahoe City, California, October 12-25, 2025
%                http://www.waspaa.com)
%
% Modified from spconf.sty (Stephen Martucci  -- stephen.martucci@ieee.org)
%
%
% Main WASPAA 2025 modifications
%    - based on IEEEtran.cls's conference style, with modifications
%      * smaller title (\huge vs. \Huge), higher spacing above title
%      * use arabic section numbering
%      * changed appearance of table and figure captions
%      * fine-tuned spacing around floats and captions
%    - removed header from past WASPAAs
%    - removed keywords
%    - new page size (181mm x 237mm)
%    - use 9pt option in \documentclass to typeset text in 9 pt; 
%      default is 10pt. (This used to be handled by \ninept macro)
%    - [preprint] package option for preprints (includes hyperlinks)
%    - [doubleblind] package option for double-blind reviews
%    - added line numbers in doubleblind mode
%    - added multiple packages in style file, including booktabs,
%      microtype, cite, hyperref, cleveref, siunitx.
%
% Preserved Features:
%    - twocolumn format
%    - boldfaced, numbered, and centered section headings
%    - correct subsection and subsubsection headings
%    - use \title{xx} for title
%    - use \name{xx} for author name(s) only, will be typeset in italics
%    - use \address{xx} for one address of all authors
%    - use \twoauthors{author1}{address1}{author2}{address2}
%         for two (or more) authors with two separate addresses
%    - note: no need for \author nor \date
%    - optional: can use \thanks{xx} within \name or \twoauthors,
%         asterisk is not printed after name nor in footnote
%    - optional: can use \sthanks{xx} after each name within \name or
%         \twoauthors if different thanks for each author,
%         footnote symbol will appear for each name and footnote
%
% Example of use for one or more authors at a common address and
%    common support. For distinct support acknowledgments,
%    use \sthanks{xx} after each name.
%
%                 \documentstyle[9pt,conference]{IEEEtran}
%                 \usepackage{waspaa25}
%                 \title{Title of the paper}
%                 \name{George P. Burdell and John Q. Professor
%                       \thanks{This work was supported by...}}
%                 \address{Common address, department \\
%                          City, etc \\
%                          optional e-mail address}
%
%                 \begin{document}
%                 \maketitle
%                 \begin{abstract}
%                 This is the abstract for my paper.
%                 \end{abstract}
%                         .
%                 Insert text of paper
%                         .
%                 \end{document}
%
% Example of use for two authors at two distinct addresses with only
%    one support acknowledgment. For distinct support acknowledgments,
%    use \sthanks{xx} after each name.
%
%                 \documentstyle[9pt,conference]{IEEEtran}
%                 \usepackage{waspaa25}
%                 \title{Title of the paper}
%                 \twoauthors{John Doe
%                       \thanks{This work was supported by...}}
%                            {Doe's address, department \\
%                             City, etc \\
%                             optional e-mail address}
%                            {Judy Smith}
%                            {Smith's address, department \\
%                             City, etc \\
%                             optional e-mail address}
%
%                 \begin{document}
%                 \maketitle
%                 \begin{abstract}
%                 This is the abstract for my paper.
%                 \end{abstract}
%                         .
%                 Insert text of paper
%                         .
%                 \end{document}
%
%
% PLEASE REPORT ANY BUGS TO THE LATEST MAINTAINER
%
